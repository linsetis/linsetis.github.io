---
import BlobDivider from './BlobDivider.astro';
import PuffyLogo from './PuffyLogo.astro';
import OvalWord from './OvalWord.astro';
import Starburst from './Starburst.astro';
import { site, socials } from '../data/site';
---
<BlobDivider top="black" bottom="pink" />
<section class="section section--pink grain contacts" id="contacts" aria-labelledby="contacts-title">
  <div class="contacts__logo" data-reveal>
    <PuffyLogo text="НАПИШИ" tag="h2" marks={false} label="Напиши" />
    <span id="contacts-title" class="visually-hidden">Контакты</span>
  </div>

  <div class="contacts__grid grid">
    <div class="contacts__links">
      <p class="micro contacts__lead">: ОТВЕЧАЮ В ТЕЧЕНИЕ ДНЯ. МОЖНО БЕЗ ТЗ, ПРОСТО С ИДЕЕЙ</p>
      <ul class="contacts__list">
        {socials.map((s, i) => {
          const external = s.href.startsWith('http');
          return (
            <li data-reveal={String(i * 0.06)}>
              <a class:list={['plaque', i % 2 ? 'plaque--white' : 'plaque--black']} href={s.href}
                style={`--r:${[-3, 2, -1, 3][i % 4]}deg`}
                target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
                <span>{s.label}</span><span class="contacts__handle">{s.handle}</span>
              </a>
            </li>
          );
        })}
      </ul>
      <Starburst size={110} seed={31} class="contacts__star" />
    </div>

    <form class="note contacts__form" data-contact-form data-endpoint={site.formEndpoint} data-email={site.email} data-reveal novalidate>
      <p class="micro contacts__form-title">: ЗАПИСКА ДЛЯ НИКИТЫ</p>
      <label class="field">
        <span class="micro micro--sm">ИМЯ</span>
        <input name="name" type="text" autocomplete="name" required />
      </label>
      <label class="field">
        <span class="micro micro--sm">КОНТАКТ : ТЕЛЕГРАМ ИЛИ ПОЧТА</span>
        <input name="contact" type="text" autocomplete="email" required />
      </label>
      <label class="field">
        <span class="micro micro--sm">ЧТО ДЕЛАЕМ?</span>
        <textarea name="message" rows="4" required></textarea>
      </label>
      <div class="contacts__submit">
        <OvalWord as="button" type="submit" class="contacts__btn">ОТПРАВИТЬ</OvalWord>
      </div>
      <p class="micro micro--sm contacts__status" role="status" aria-live="polite" data-status></p>
    </form>
  </div>
</section>

<style>
  .contacts { padding-top: clamp(24px, 4vw, 56px); }
  .contacts__logo { margin-inline: calc(var(--gutter) * -0.4); }
  .contacts__grid { margin-top: clamp(32px, 5vw, 64px); row-gap: 40px; align-items: start; }
  .contacts__links { grid-column: 1 / span 6; position: relative; }
  .contacts__lead { max-width: 32ch; margin-bottom: 24px; }
  .contacts__list { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; }
  .plaque {
    display: inline-flex; align-items: baseline; flex-wrap: wrap; gap: 0.3em 0.8em; max-width: 100%;
    font-family: var(--font-head); font-weight: 500; font-size: clamp(16px, 1.6vw, 20px); line-height: 1;
    text-transform: uppercase; letter-spacing: 0.03em; text-decoration: none;
    padding: 10px 14px 9px; border: 1px solid var(--black); rotate: var(--r);
    transition: rotate var(--t-fast) var(--ease-spring), translate var(--t-fast);
  }
  .plaque--white { background: var(--white); color: var(--black); }
  .plaque--black { background: var(--black); color: var(--white); }
  .plaque:hover { rotate: 0deg; translate: 0 -2px; }
  .contacts__handle { font-family: var(--font-mono); font-size: 12px; text-transform: none; letter-spacing: 0; }
  .contacts__star { position: absolute; right: 8%; bottom: -10px; }

  .contacts__form {
    grid-column: 7 / span 6; justify-self: end; width: 100%; max-width: 420px;
    rotate: 1.5deg; padding: 24px 24px 20px; display: flex; flex-direction: column; gap: 18px;
  }
  .contacts__form-title { margin-bottom: 2px; }
  .field { display: flex; flex-direction: column; gap: 4px; }
  .field input, .field textarea {
    font: inherit; font-size: var(--fs-note); color: var(--black);
    background: transparent; border: 0; border-bottom: 1px solid var(--black);
    padding: 6px 0; border-radius: 0; resize: vertical; width: 100%;
  }
  .field input:focus-visible, .field textarea:focus-visible { outline: none; border-bottom-width: 2px; padding-bottom: 5px; }
  .contacts__submit { display: flex; justify-content: flex-end; padding: 6px 10px 4px; }
  .contacts__btn { font-family: var(--font-head); font-size: 22px; text-transform: uppercase; color: var(--black); }
  .contacts__status { min-height: 1.4em; }

  @media (max-width: 820px) {
    .contacts__links, .contacts__form { grid-column: 1 / -1; }
    .contacts__form { justify-self: center; rotate: 1deg; }
    .contacts__star { right: 0; bottom: auto; top: 30px; }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  if (form) {
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        status.textContent = ': ЗАПОЛНИ ВСЕ ТРИ ПОЛЯ';
        form.querySelector<HTMLElement>(':invalid')?.focus();
        return;
      }
      const data = new FormData(form);
      const endpoint = form.dataset.endpoint ?? '';
      if (endpoint) {
        status.textContent = ': ОТПРАВЛЯЮ…';
        try {
          const res = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
          if (!res.ok) throw new Error(String(res.status));
          form.reset();
          status.textContent = ': ГОТОВО! СКОРО ОТВЕЧУ';
        } catch {
          status.textContent = ': НЕ ВЫШЛО. НАПИШИ В ТЕЛЕГРАМ ИЛИ НА ПОЧТУ';
        }
        return;
      }
      const name = String(data.get('name') ?? '');
      const contact = String(data.get('contact') ?? '');
      const message = String(data.get('message') ?? '');
      const subject = `Проект от ${name}`;
      const body = `${message}\n\n— ${name}\nКонтакт: ${contact}`;
      window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      status.textContent = ': ОТКРЫВАЮ ПОЧТУ…';
    });
  }
</script>
