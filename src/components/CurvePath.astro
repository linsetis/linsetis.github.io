---
// Петляющая линия 1px, соединяющая элементы [data-curve-node] внутри родителя [data-curve-root].
// Путь строится в рантайме по реальным координатам узлов (устойчиво к любой сетке).
interface Props { class?: string; }
const { class: cls = '' } = Astro.props;
---
<svg class:list={['curve', cls]} data-curve aria-hidden="true">
  <path fill="none" stroke="var(--black)" stroke-width="1" vector-effect="non-scaling-stroke" />
</svg>
<style>
  .curve { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; overflow: visible; z-index: 0; }
</style>
<script>
  import { buildCurves } from '../lib/curve';
  buildCurves();
</script>
