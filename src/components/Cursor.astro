---
import { starburstPath } from '../lib/starburst';
---
<div class="cursor" aria-hidden="true" data-cursor>
  <svg viewBox="-52 -52 104 104"><path d={starburstPath(77, 9)} fill="var(--ice)" stroke="var(--black)" stroke-width="5" stroke-linejoin="round" /></svg>
</div>
<style>
  .cursor { position: fixed; left: 0; top: 0; width: 22px; height: 22px; margin: -11px 0 0 -11px; pointer-events: none; z-index: 1000; opacity: 0; transition: opacity var(--t-fast), scale var(--t-mid) var(--ease-spring); }
  .cursor svg { width: 100%; height: 100%; animation: cur-spin 6s linear infinite; }
  :global(html.has-cursor) .cursor { opacity: 1; }
  :global(html.has-cursor), :global(html.has-cursor a), :global(html.has-cursor button) { cursor: none; }
  :global(html.has-cursor input), :global(html.has-cursor textarea) { cursor: text; }
  .cursor.is-big { scale: 2.2; }
  @keyframes cur-spin { to { rotate: 360deg; } }
</style>
<script>
  const mq = window.matchMedia('(hover: hover) and (pointer: fine)');
  const el = document.querySelector<HTMLElement>('[data-cursor]');
  if (mq.matches && el) {
    let x = 0, y = 0, cx = 0, cy = 0, raf = 0;
    const loop = () => {
      cx += (x - cx) * 0.3; cy += (y - cy) * 0.3;
      el.style.transform = `translate(${cx}px, ${cy}px)`;
      raf = Math.abs(x - cx) + Math.abs(y - cy) > 0.1 ? requestAnimationFrame(loop) : 0;
    };
    window.addEventListener('pointermove', (e) => {
      x = e.clientX; y = e.clientY;
      document.documentElement.classList.add('has-cursor');
      if (!raf) raf = requestAnimationFrame(loop);
      const t = e.target as Element | null;
      el.classList.toggle('is-big', !!t?.closest('a, button, [role="button"], label'));
    }, { passive: true });
    document.addEventListener('pointerleave', () => document.documentElement.classList.remove('has-cursor'));
  }
</script>
