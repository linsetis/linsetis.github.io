---
import Starburst from './Starburst.astro';
import { site } from '../data/site';
---
<footer class="section section--black footer">
  <p class="micro">© 2026 {site.name.toUpperCase()} · @{site.nick.toUpperCase()}</p>
  <p class="footer__right micro">
    <Starburst size={22} seed={8} spin />
    СДЕЛАНО С ПРОМАХАМИ И ЛЮБОВЬЮ
  </p>
</footer>
<style>
  .footer {
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px 24px;
    padding-top: 22px; padding-bottom: 22px;
  }
  .footer__right { display: flex; align-items: center; gap: 10px; color: var(--pink); }
</style>
