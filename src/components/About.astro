---
// Секция 2 «ОБО МНЕ» (чёрная): коллаж + LINSETIS + иллюстрация + подпись с OvalWord.
import PhotoFrame from './PhotoFrame.astro';
import Starburst from './Starburst.astro';
import OvalWord from './OvalWord.astro';
import Tag from './Tag.astro';
import { site } from '../data/site';
---
<section class="section section--black grain about" id="about" aria-labelledby="about-title">
  <div class="about__grid grid">
    <!-- Коллаж слева -->
    <div class="about__collage">
      <div class="c-work" data-reveal data-parallax="0.15">
        <!-- TODO: заменить — фото рабочего места -->
        <PhotoFrame src="/images/about-workplace.svg" alt="Рабочее место Никиты: стол, скетчбуки, маркеры" rotate={-4} ratio={4 / 3} caption=": стол, 3 часа ночи" />
      </div>
      <div class="c-portrait" data-reveal="0.1" data-parallax="0.3">
        <!-- TODO: заменить — портрет Никиты -->
        <PhotoFrame src="/images/about-portrait.svg" alt="Портрет Никиты Фоменко" rotate={5} ratio={4 / 5} gray />
      </div>
      <div class="c-note" data-reveal="0.2">
        <p class="note">
          никита фоменко — дизайнер, который не боится ошибаться. каждый промах — это черновик хорошей идеи. я делаю айдентику, плакаты и сайты с характером.
        </p>
      </div>
      <Starburst class="c-star c-star--1" size={84} seed={21} />
      <Starburst class="c-star c-star--2" size={56} seed={34} />
    </div>

    <!-- Справа: LINSETIS -->
    <div class="about__intro">
      <p class="micro about__label">: обо мне</p>
      <h2 class="h h--display about__nick" id="about-title" data-reveal>
        <span class="visually-hidden">Обо мне — </span>LINSETIS
      </h2>
      <p class="h h--sm about__motto" data-reveal="0.1">
        Это дизайн, в котором можно дышать без напряжения и снобизма
      </p>
    </div>

    <!-- Большая иллюстрация -->
    <div class="about__art" data-reveal data-parallax="0.12">
      <!-- TODO: заменить — любимая работа из портфолио -->
      <PhotoFrame src="/images/about-artwork.svg" alt="Работа из портфолио Никиты Фоменко" rotate={2} ratio={16 / 10} />
      <Tag class="about__art-tag" variant="white" rotate={-6}>работа из портфолио</Tag>
      <Starburst class="about__art-star" size={110} seed={55} />
    </div>

    <!-- Низ -->
    <div class="about__bottom">
      <p class="h h--sm about__claim">
        Не нужно знать дизайн, чтобы получить <OvalWord rotate={-4}>вещь</OvalWord>
      </p>
      <p class="about__years" aria-label={`Годы практики: ${site.years}`}>{site.years}</p>
    </div>
  </div>
</section>

<style>
  .about { overflow: clip; }
  .about__grid { position: relative; z-index: 1; row-gap: clamp(32px, 5vw, 64px); align-items: start; }

  /* ---------- Коллаж ---------- */
  .about__collage {
    grid-column: 1 / 7;
    grid-row: 1 / 3;
    position: relative;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    padding-top: 8px;
  }
  .c-work { grid-column: 1 / 5; grid-row: 1; z-index: 1; }
  .c-portrait { grid-column: 4 / 7; grid-row: 1 / 3; margin-top: 34%; z-index: 2; }
  .c-note { grid-column: 1 / 5; grid-row: 2; margin-top: -28px; margin-left: 6%; z-index: 3; }
  .c-note .note { rotate: -2deg; }
  .about__collage :global(.c-star) { position: absolute; z-index: 4; }
  .about__collage :global(.c-star--1) { left: 56%; top: 22%; }
  .about__collage :global(.c-star--2) { left: 46%; bottom: 4%; }

  /* ---------- LINSETIS ---------- */
  .about__intro {
    grid-column: 7 / 13;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
    gap: 18px;
  }
  .about__label { color: var(--pink); }
  .about__nick {
    color: var(--pink);
    font-size: clamp(56px, 1rem + 10vw, 148px);
    letter-spacing: -0.01em;
    rotate: -2deg;
  }
  .about__motto { color: var(--white); max-width: 15em; text-align: right; }

  /* ---------- Иллюстрация ---------- */
  .about__art {
    grid-column: 7 / 13;
    grid-row: 2;
    position: relative;
    margin-top: clamp(8px, 2vw, 32px);
    margin-left: -18%;
    z-index: 2;
  }
  .about__art :global(.about__art-tag) { position: absolute; left: -8px; top: -14px; z-index: 3; }
  .about__art :global(.about__art-star) { position: absolute; right: -28px; bottom: -36px; z-index: 3; }

  /* ---------- Низ ---------- */
  .about__bottom {
    grid-column: 1 / -1;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    padding-top: clamp(20px, 3vw, 32px);
    border-top: 1px solid var(--white);
    margin-top: clamp(16px, 3vw, 40px);
  }
  .about__claim { color: var(--white); max-width: 22em; }
  .about__claim :global(.oval) { color: var(--pink); }
  .about__years {
    font-family: var(--font-mono);
    font-size: clamp(14px, 1.6vw, 20px);
    letter-spacing: var(--ls-micro);
    color: var(--pink);
    white-space: nowrap;
  }

  /* ---------- Планшет ---------- */
  @media (max-width: 960px) {
    .about__collage { grid-column: 1 / 8; }
    .about__intro { grid-column: 8 / 13; }
    .about__art { grid-column: 4 / 13; grid-row: 3; margin-left: 0; }
  }

  /* ---------- Мобильный: колонка ---------- */
  @media (max-width: 720px) {
    .about__collage, .about__intro, .about__art { grid-column: 1 / -1; grid-row: auto; }
    .about__intro { order: -1; }
    .about__collage { padding-inline: 6px; }
    .c-work { grid-column: 1 / 6; }
    .c-portrait { grid-column: 3 / 7; margin-top: 46%; }
    .c-note { grid-column: 1 / 6; grid-row: 3; margin-top: -20px; margin-left: 0; }
    .about__collage :global(.c-star--1) { left: auto; right: 4%; top: 4%; }
    .about__collage :global(.c-star--2) { left: auto; right: 8%; bottom: -10px; }
    .about__art { margin-inline: 4px; }
    .about__art :global(.about__art-star) { right: -6px; bottom: -28px; width: 72px; height: 72px; }
    .about__bottom { flex-direction: column; align-items: flex-start; }
  }
</style>
