---
interface Props { as?: 'span' | 'button'; type?: 'button' | 'submit'; class?: string; rotate?: number; }
const { as: El = 'span', type, class: cls = '', rotate = -3 } = Astro.props;
---
<El class:list={['oval', cls]} type={El === 'button' ? (type ?? 'button') : undefined} style={`--r:${rotate}deg`}>
  <span class="oval__txt"><slot /></span>
  <svg class="oval__ring" viewBox="0 0 200 80" preserveAspectRatio="none" aria-hidden="true">
    <path d="M28 18C70 2 168 4 190 30c16 22-30 42-92 44C40 76 6 62 10 40 14 22 48 10 110 8c30-1 58 3 72 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/>
  </svg>
</El>
<style>
  .oval { position: relative; display: inline-block; padding: 0.1em 0.45em; white-space: nowrap; background: none; border: 0; cursor: pointer; }
  span.oval { cursor: inherit; }
  .oval__txt { position: relative; z-index: 1; }
  .oval__ring { position: absolute; inset: -14% -10%; width: 120%; height: 128%; rotate: var(--r); overflow: visible; pointer-events: none; transition: rotate var(--t-mid) var(--ease-spring); }
  button.oval:hover .oval__ring { rotate: 2deg; }
</style>
